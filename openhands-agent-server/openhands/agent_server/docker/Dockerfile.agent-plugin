# syntax=docker/dockerfile:1.7
#
# Dockerfile.agent-plugin — builds the portable agent-plugin image.
#
# The agent-plugin consolidates everything under /agent-server/ so a single
# volume mount provides the complete plugin to ANY Debian/Ubuntu-based
# environment image. No per-image layers, no duplication.
#
#   /agent-server/
#     ├── .venv/              Python venv (agent server)
#     ├── uv-managed-python/  Managed Python runtime
#     ├── bin/                Default binaries (bookworm) — backward compat
#     ├── lib/                Default shared libs (bookworm) — backward compat
#     ├── variants/
#     │   ├── buster/{bin,lib}    glibc 2.28 (Debian 10, Ubuntu 18.04)
#     │   ├── bullseye/{bin,lib}  glibc 2.31 (Debian 11, Ubuntu 20.04/22.04)
#     │   └── bookworm/{bin,lib}  glibc 2.36 (Debian 12, Ubuntu 23.04+)
#     └── openhands-*/        Source packages
#
# Build (from repo root):
#   docker build -f openhands-agent-server/openhands/agent_server/docker/Dockerfile.agent-plugin \
#     -t openhands/agent-plugin .
#
# With options:
#   docker build -f openhands-agent-server/openhands/agent_server/docker/Dockerfile.agent-plugin \
#     --build-arg INSTALL_RIPGREP=true \
#     --build-arg INSTALL_BUILD_TOOLS=true \
#     -t openhands/agent-plugin .
#
# Runtime (data container pattern):
#   docker create --name=agent-plugin openhands/agent-plugin true
#   docker run --volumes-from=agent-plugin \
#     -e PATH="/agent-server/bin:/agent-server/.venv/bin:$PATH" \
#     -e UV_PYTHON_INSTALL_DIR=/agent-server/uv-managed-python \
#     -e LD_LIBRARY_PATH="/agent-server/lib" \
#     my-env-image python -m openhands.agent_server
#
# For older glibc targets, FlexWorkspace detects the glibc version and uses
# the matching variant directory instead of the default bin/lib.

ARG USERNAME=openhands
ARG UID=10001
ARG GID=10001

# Hot-pluggable package toggles
ARG USE_CN_MIRRORS=false
ARG INSTALL_AGENT_TOOLS=true
ARG INSTALL_RIPGREP=false
ARG INSTALL_BUILD_TOOLS=false

####################################################################################
# Builder (source mode)
# Copy source + build a venv.
####################################################################################
FROM python:3.12-bullseye AS builder
ARG USERNAME UID GID
ENV UV_PROJECT_ENVIRONMENT=/agent-server/.venv
ENV UV_PYTHON_INSTALL_DIR=/agent-server/uv-managed-python

COPY --from=ghcr.io/astral-sh/uv /uv /uvx /bin/

RUN groupadd -g ${GID} ${USERNAME} \
 && useradd -m -u ${UID} -g ${GID} -s /usr/sbin/nologin ${USERNAME}
USER ${USERNAME}
WORKDIR /agent-server
# Cache-friendly: lockfiles first
COPY --chown=${USERNAME}:${USERNAME} pyproject.toml uv.lock README.md LICENSE ./
COPY --chown=${USERNAME}:${USERNAME} openhands-sdk ./openhands-sdk
COPY --chown=${USERNAME}:${USERNAME} openhands-tools ./openhands-tools
COPY --chown=${USERNAME}:${USERNAME} openhands-workspace ./openhands-workspace
COPY --chown=${USERNAME}:${USERNAME} openhands-agent-server ./openhands-agent-server
RUN --mount=type=cache,target=/home/${USERNAME}/.cache,uid=${UID},gid=${GID} \
    uv python install 3.12 && uv venv --python 3.12 .venv && uv sync --frozen --no-editable --managed-python

####################################################################################
# Binary Builder (binary mode)
####################################################################################
FROM builder AS binary-builder
ARG USERNAME UID GID

RUN --mount=type=cache,target=/home/${USERNAME}/.cache,uid=${UID},gid=${GID} \
    uv sync --frozen --dev --no-editable

RUN --mount=type=cache,target=/home/${USERNAME}/.cache,uid=${UID},gid=${GID} \
    uv run pyinstaller openhands-agent-server/openhands/agent_server/agent-server.spec
RUN test -x /agent-server/dist/openhands-agent-server

####################################################################################
# Pluggable package stages — multi-glibc
#
# Each group is built per Debian release, producing a FROM scratch image
# containing ONLY the delta files (binaries + libs). Disabled = empty scratch
# = zero overhead thanks to BuildKit lazy evaluation.
#
# Supported variants: buster (glibc 2.28), bullseye (glibc 2.31),
#                     bookworm (glibc 2.36)
####################################################################################

# ── Buster pkg-base ────────────────────────────────────────────────────────────
FROM debian:buster-slim AS pkg-base-buster
ARG USE_CN_MIRRORS
RUN if [ "${USE_CN_MIRRORS}" = "true" ]; then \
        sed -i 's/deb.debian.org/mirrors.ustc.edu.cn/g' /etc/apt/sources.list 2>/dev/null || true; \
    fi && \
    sed -i 's|deb.debian.org|archive.debian.org|g' /etc/apt/sources.list 2>/dev/null || true && \
    sed -i '/security.debian.org/d' /etc/apt/sources.list 2>/dev/null || true && \
    sed -i '/updates/d' /etc/apt/sources.list 2>/dev/null || true && \
    echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99no-check-valid-until

# ── Bullseye pkg-base ──────────────────────────────────────────────────────────
FROM debian:bullseye-slim AS pkg-base-bullseye
ARG USE_CN_MIRRORS
RUN if [ "${USE_CN_MIRRORS}" = "true" ]; then \
        sed -i 's/deb.debian.org/mirrors.ustc.edu.cn/g' /etc/apt/sources.list 2>/dev/null || true; \
    fi

# ── Bookworm pkg-base (default) ───────────────────────────────────────────────
FROM debian:bookworm-slim AS pkg-base-bookworm
ARG USE_CN_MIRRORS
RUN if [ "${USE_CN_MIRRORS}" = "true" ]; then \
        sed -i 's/deb.debian.org/mirrors.ustc.edu.cn/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true; \
        sed -i 's/deb.debian.org/mirrors.ustc.edu.cn/g' /etc/apt/sources.list 2>/dev/null || true; \
    fi

# Backward-compatible alias
FROM pkg-base-bookworm AS pkg-base

####################################################################################
# Macro: build one package group on a given Debian base.
# We repeat the pattern for each (distro, package-group) combination.
####################################################################################

# ── Agent tools per distro ─────────────────────────────────────────────────────
FROM pkg-base-buster AS pkg-agent-tools-builder-buster
RUN find / -xdev -not -path '/tmp/*' \( -type f -o -type l \) | sort > /tmp/before.txt && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        curl wget jq apt-transport-https gnupg lsb-release && \
    rm -rf /var/lib/apt/lists/* && \
    find / -xdev -not -path '/tmp/*' -not -path '/pkg/*' \( -type f -o -type l \) | sort > /tmp/after.txt && \
    comm -13 /tmp/before.txt /tmp/after.txt > /tmp/new.txt && \
    mkdir /pkg && tar cf - -T /tmp/new.txt 2>/dev/null | tar xf - -C /pkg
FROM scratch AS pkg-agent-tools-buster
COPY --from=pkg-agent-tools-builder-buster /pkg /

FROM pkg-base-bullseye AS pkg-agent-tools-builder-bullseye
RUN find / -xdev -not -path '/tmp/*' \( -type f -o -type l \) | sort > /tmp/before.txt && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        curl wget jq apt-transport-https gnupg lsb-release && \
    rm -rf /var/lib/apt/lists/* && \
    find / -xdev -not -path '/tmp/*' -not -path '/pkg/*' \( -type f -o -type l \) | sort > /tmp/after.txt && \
    comm -13 /tmp/before.txt /tmp/after.txt > /tmp/new.txt && \
    mkdir /pkg && tar cf - -T /tmp/new.txt 2>/dev/null | tar xf - -C /pkg
FROM scratch AS pkg-agent-tools-bullseye
COPY --from=pkg-agent-tools-builder-bullseye /pkg /

FROM pkg-base-bookworm AS pkg-agent-tools-builder-bookworm
RUN find / -xdev -not -path '/tmp/*' \( -type f -o -type l \) | sort > /tmp/before.txt && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        curl wget jq apt-transport-https gnupg lsb-release && \
    rm -rf /var/lib/apt/lists/* && \
    find / -xdev -not -path '/tmp/*' -not -path '/pkg/*' \( -type f -o -type l \) | sort > /tmp/after.txt && \
    comm -13 /tmp/before.txt /tmp/after.txt > /tmp/new.txt && \
    mkdir /pkg && tar cf - -T /tmp/new.txt 2>/dev/null | tar xf - -C /pkg
FROM scratch AS pkg-agent-tools-bookworm
COPY --from=pkg-agent-tools-builder-bookworm /pkg /

# Default alias (bookworm)
FROM scratch AS pkg-agent-tools
COPY --from=pkg-agent-tools-bookworm / /

# ── Ripgrep per distro ─────────────────────────────────────────────────────────
# Note: ripgrep may not be in older repos; install errors are tolerated.
FROM pkg-base-buster AS pkg-ripgrep-builder-buster
RUN find / -xdev -not -path '/tmp/*' \( -type f -o -type l \) | sort > /tmp/before.txt && \
    apt-get update && \
    (apt-get install -y --no-install-recommends ripgrep || true) && \
    rm -rf /var/lib/apt/lists/* && \
    find / -xdev -not -path '/tmp/*' -not -path '/pkg/*' \( -type f -o -type l \) | sort > /tmp/after.txt && \
    comm -13 /tmp/before.txt /tmp/after.txt > /tmp/new.txt && \
    mkdir /pkg && tar cf - -T /tmp/new.txt 2>/dev/null | tar xf - -C /pkg
FROM scratch AS pkg-ripgrep-buster
COPY --from=pkg-ripgrep-builder-buster /pkg /

FROM pkg-base-bullseye AS pkg-ripgrep-builder-bullseye
RUN find / -xdev -not -path '/tmp/*' \( -type f -o -type l \) | sort > /tmp/before.txt && \
    apt-get update && \
    (apt-get install -y --no-install-recommends ripgrep || true) && \
    rm -rf /var/lib/apt/lists/* && \
    find / -xdev -not -path '/tmp/*' -not -path '/pkg/*' \( -type f -o -type l \) | sort > /tmp/after.txt && \
    comm -13 /tmp/before.txt /tmp/after.txt > /tmp/new.txt && \
    mkdir /pkg && tar cf - -T /tmp/new.txt 2>/dev/null | tar xf - -C /pkg
FROM scratch AS pkg-ripgrep-bullseye
COPY --from=pkg-ripgrep-builder-bullseye /pkg /

FROM pkg-base-bookworm AS pkg-ripgrep-builder-bookworm
RUN find / -xdev -not -path '/tmp/*' \( -type f -o -type l \) | sort > /tmp/before.txt && \
    apt-get update && \
    apt-get install -y --no-install-recommends ripgrep && \
    rm -rf /var/lib/apt/lists/* && \
    find / -xdev -not -path '/tmp/*' -not -path '/pkg/*' \( -type f -o -type l \) | sort > /tmp/after.txt && \
    comm -13 /tmp/before.txt /tmp/after.txt > /tmp/new.txt && \
    mkdir /pkg && tar cf - -T /tmp/new.txt 2>/dev/null | tar xf - -C /pkg
FROM scratch AS pkg-ripgrep-bookworm
COPY --from=pkg-ripgrep-builder-bookworm /pkg /

FROM scratch AS pkg-ripgrep
COPY --from=pkg-ripgrep-bookworm / /

# ── Build tools per distro ─────────────────────────────────────────────────────
FROM pkg-base-buster AS pkg-build-tools-builder-buster
RUN find / -xdev -not -path '/tmp/*' \( -type f -o -type l \) | sort > /tmp/before.txt && \
    apt-get update && \
    apt-get install -y --no-install-recommends build-essential && \
    rm -rf /var/lib/apt/lists/* && \
    find / -xdev -not -path '/tmp/*' -not -path '/pkg/*' \( -type f -o -type l \) | sort > /tmp/after.txt && \
    comm -13 /tmp/before.txt /tmp/after.txt > /tmp/new.txt && \
    mkdir /pkg && tar cf - -T /tmp/new.txt 2>/dev/null | tar xf - -C /pkg
FROM scratch AS pkg-build-tools-buster
COPY --from=pkg-build-tools-builder-buster /pkg /

FROM pkg-base-bullseye AS pkg-build-tools-builder-bullseye
RUN find / -xdev -not -path '/tmp/*' \( -type f -o -type l \) | sort > /tmp/before.txt && \
    apt-get update && \
    apt-get install -y --no-install-recommends build-essential && \
    rm -rf /var/lib/apt/lists/* && \
    find / -xdev -not -path '/tmp/*' -not -path '/pkg/*' \( -type f -o -type l \) | sort > /tmp/after.txt && \
    comm -13 /tmp/before.txt /tmp/after.txt > /tmp/new.txt && \
    mkdir /pkg && tar cf - -T /tmp/new.txt 2>/dev/null | tar xf - -C /pkg
FROM scratch AS pkg-build-tools-bullseye
COPY --from=pkg-build-tools-builder-bullseye /pkg /

FROM pkg-base-bookworm AS pkg-build-tools-builder-bookworm
RUN find / -xdev -not -path '/tmp/*' \( -type f -o -type l \) | sort > /tmp/before.txt && \
    apt-get update && \
    apt-get install -y --no-install-recommends build-essential && \
    rm -rf /var/lib/apt/lists/* && \
    find / -xdev -not -path '/tmp/*' -not -path '/pkg/*' \( -type f -o -type l \) | sort > /tmp/after.txt && \
    comm -13 /tmp/before.txt /tmp/after.txt > /tmp/new.txt && \
    mkdir /pkg && tar cf - -T /tmp/new.txt 2>/dev/null | tar xf - -C /pkg
FROM scratch AS pkg-build-tools-bookworm
COPY --from=pkg-build-tools-builder-bookworm /pkg /

FROM scratch AS pkg-build-tools
COPY --from=pkg-build-tools-bookworm / /

# ── Conditional selectors (ARG-driven stage name interpolation) ────────────────
FROM scratch AS pkg-agent-tools-true
COPY --from=pkg-agent-tools / /
FROM scratch AS pkg-agent-tools-false

FROM scratch AS pkg-ripgrep-true
COPY --from=pkg-ripgrep / /
FROM scratch AS pkg-ripgrep-false

FROM scratch AS pkg-build-tools-true
COPY --from=pkg-build-tools / /
FROM scratch AS pkg-build-tools-false

FROM pkg-agent-tools-${INSTALL_AGENT_TOOLS}  AS selected-agent-tools
FROM pkg-ripgrep-${INSTALL_RIPGREP}          AS selected-ripgrep
FROM pkg-build-tools-${INSTALL_BUILD_TOOLS}  AS selected-build-tools

# Per-variant conditional selectors
FROM scratch AS pkg-agent-tools-buster-true
COPY --from=pkg-agent-tools-buster / /
FROM scratch AS pkg-agent-tools-buster-false

FROM scratch AS pkg-agent-tools-bullseye-true
COPY --from=pkg-agent-tools-bullseye / /
FROM scratch AS pkg-agent-tools-bullseye-false

FROM scratch AS pkg-ripgrep-buster-true
COPY --from=pkg-ripgrep-buster / /
FROM scratch AS pkg-ripgrep-buster-false

FROM scratch AS pkg-ripgrep-bullseye-true
COPY --from=pkg-ripgrep-bullseye / /
FROM scratch AS pkg-ripgrep-bullseye-false

FROM scratch AS pkg-build-tools-buster-true
COPY --from=pkg-build-tools-buster / /
FROM scratch AS pkg-build-tools-buster-false

FROM scratch AS pkg-build-tools-bullseye-true
COPY --from=pkg-build-tools-bullseye / /
FROM scratch AS pkg-build-tools-bullseye-false

FROM pkg-agent-tools-buster-${INSTALL_AGENT_TOOLS}    AS selected-agent-tools-buster
FROM pkg-agent-tools-bullseye-${INSTALL_AGENT_TOOLS}   AS selected-agent-tools-bullseye
FROM pkg-ripgrep-buster-${INSTALL_RIPGREP}             AS selected-ripgrep-buster
FROM pkg-ripgrep-bullseye-${INSTALL_RIPGREP}            AS selected-ripgrep-bullseye
FROM pkg-build-tools-buster-${INSTALL_BUILD_TOOLS}     AS selected-build-tools-buster
FROM pkg-build-tools-bullseye-${INSTALL_BUILD_TOOLS}    AS selected-build-tools-bullseye

####################################################################################
# Helper: flatten staged packages into bin/ and lib/
# Used as a build script inside busybox stages.
####################################################################################

####################################################################################
# Agent Plugin (portable, mountable)
#
# Consolidates everything under /agent-server/ so a single volume mount
# provides the complete plugin.  Includes per-glibc variant directories.
####################################################################################
FROM busybox AS agent-plugin
# Core: venv + managed python + source
COPY --from=builder /agent-server /agent-server
# Binaries: uv, uvx (statically linked — glibc-independent)
COPY --from=ghcr.io/astral-sh/uv /uv  /agent-server/bin/uv
COPY --from=ghcr.io/astral-sh/uv /uvx /agent-server/bin/uvx

# ── Default variant (bookworm) → /agent-server/{bin,lib} ──────────────────────
COPY --from=selected-agent-tools / /agent-server/tools-staging/
COPY --from=selected-ripgrep     / /agent-server/tools-staging/
COPY --from=selected-build-tools / /agent-server/tools-staging/
RUN mkdir -p /agent-server/bin /agent-server/lib && \
    for d in usr/bin usr/sbin bin sbin; do \
        [ -d "/agent-server/tools-staging/$d" ] && \
        cp -a /agent-server/tools-staging/$d/* /agent-server/bin/ 2>/dev/null; \
    done; \
    for d in usr/lib/x86_64-linux-gnu usr/lib lib; do \
        [ -d "/agent-server/tools-staging/$d" ] && \
        find /agent-server/tools-staging/$d -maxdepth 1 \( -name '*.so*' -o -name '*.a' \) \
            -exec cp -a {} /agent-server/lib/ \; 2>/dev/null; \
    done; \
    rm -rf /agent-server/tools-staging

# ── Buster variant → /agent-server/variants/buster/{bin,lib} ──────────────────
COPY --from=selected-agent-tools-buster  / /agent-server/tools-staging/
COPY --from=selected-ripgrep-buster      / /agent-server/tools-staging/
COPY --from=selected-build-tools-buster  / /agent-server/tools-staging/
RUN mkdir -p /agent-server/variants/buster/bin /agent-server/variants/buster/lib && \
    cp -a /agent-server/bin/uv  /agent-server/variants/buster/bin/uv  2>/dev/null; \
    cp -a /agent-server/bin/uvx /agent-server/variants/buster/bin/uvx 2>/dev/null; \
    for d in usr/bin usr/sbin bin sbin; do \
        [ -d "/agent-server/tools-staging/$d" ] && \
        cp -a /agent-server/tools-staging/$d/* /agent-server/variants/buster/bin/ 2>/dev/null; \
    done; \
    for d in usr/lib/x86_64-linux-gnu usr/lib lib; do \
        [ -d "/agent-server/tools-staging/$d" ] && \
        find /agent-server/tools-staging/$d -maxdepth 1 \( -name '*.so*' -o -name '*.a' \) \
            -exec cp -a {} /agent-server/variants/buster/lib/ \; 2>/dev/null; \
    done; \
    rm -rf /agent-server/tools-staging

# ── Bullseye variant → /agent-server/variants/bullseye/{bin,lib} ──────────────
COPY --from=selected-agent-tools-bullseye  / /agent-server/tools-staging/
COPY --from=selected-ripgrep-bullseye      / /agent-server/tools-staging/
COPY --from=selected-build-tools-bullseye  / /agent-server/tools-staging/
RUN mkdir -p /agent-server/variants/bullseye/bin /agent-server/variants/bullseye/lib && \
    cp -a /agent-server/bin/uv  /agent-server/variants/bullseye/bin/uv  2>/dev/null; \
    cp -a /agent-server/bin/uvx /agent-server/variants/bullseye/bin/uvx 2>/dev/null; \
    for d in usr/bin usr/sbin bin sbin; do \
        [ -d "/agent-server/tools-staging/$d" ] && \
        cp -a /agent-server/tools-staging/$d/* /agent-server/variants/bullseye/bin/ 2>/dev/null; \
    done; \
    for d in usr/lib/x86_64-linux-gnu usr/lib lib; do \
        [ -d "/agent-server/tools-staging/$d" ] && \
        find /agent-server/tools-staging/$d -maxdepth 1 \( -name '*.so*' -o -name '*.a' \) \
            -exec cp -a {} /agent-server/variants/bullseye/lib/ \; 2>/dev/null; \
    done; \
    rm -rf /agent-server/tools-staging

VOLUME /agent-server

# Backward-compatible alias
FROM agent-plugin AS agent-tools

####################################################################################
# Binary-only plugin variant (smaller, no source/venv)
# NOTE: This target only includes bookworm (default) tools — no multi-glibc
# variant directories. If you need buster/bullseye support, use the
# agent-plugin target instead.
####################################################################################
FROM busybox AS agent-plugin-binary
COPY --from=binary-builder /agent-server/dist/openhands-agent-server /agent-server/bin/openhands-agent-server
COPY --from=ghcr.io/astral-sh/uv /uv  /agent-server/bin/uv
COPY --from=ghcr.io/astral-sh/uv /uvx /agent-server/bin/uvx
COPY --from=selected-agent-tools / /agent-server/tools-staging/
COPY --from=selected-ripgrep     / /agent-server/tools-staging/
COPY --from=selected-build-tools / /agent-server/tools-staging/
RUN mkdir -p /agent-server/bin /agent-server/lib && \
    for d in usr/bin usr/sbin bin sbin; do \
        [ -d "/agent-server/tools-staging/$d" ] && \
        cp -a /agent-server/tools-staging/$d/* /agent-server/bin/ 2>/dev/null; \
    done; \
    for d in usr/lib/x86_64-linux-gnu usr/lib lib; do \
        [ -d "/agent-server/tools-staging/$d" ] && \
        find /agent-server/tools-staging/$d -maxdepth 1 \( -name '*.so*' -o -name '*.a' \) \
            -exec cp -a {} /agent-server/lib/ \; 2>/dev/null; \
    done; \
    rm -rf /agent-server/tools-staging
VOLUME /agent-server
